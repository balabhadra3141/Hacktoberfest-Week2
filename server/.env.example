# Database
DATABASE_URL="file:./dev.db"

# Server
PORT=3001
NODE_ENV=development

# Ollama AI Configuration
# Run `ollama list` to see the exact tags available on your machine.
# This is only the default: the active model can also be switched at
# runtime from Store Settings -> AI Model Setup (persisted in the DB).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
# Extraction timeout. Local models on CPU are slow (an 8B model can take
# ~30s per ledger line); raise this if big registers time out and fall back
# to the offline rule engine.
OLLAMA_TIMEOUT_MS=180000

# Upload limits
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads

# CORS
CORS_ORIGIN=http://localhost:5173
